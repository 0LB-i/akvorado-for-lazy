# Copie para .env e ajuste os valores.
# O script scripts/bootstrap.sh e o scripts/install.sh geram o .env
# automaticamente perguntando usuário/senha, então normalmente você
# não precisa editar isso à mão.

# Credenciais do ClickHouse (único serviço da stack que pede autenticação)
CLICKHOUSE_DB=akvorado
CLICKHOUSE_USER=akvorado
CLICKHOUSE_PASSWORD=akvorado123

# Versão da imagem clickhouse/clickhouse-server. Detectada e preenchida
# automaticamente pelo scripts/install.sh de acordo com o suporte a AVX2 da
# CPU (builds recentes exigem AVX2 e travam com "Illegal instruction" sem
# ele). Deixe em branco/comentado para deixar a detecção automática decidir.
# CLICKHOUSE_VERSION=latest

# Endereço onde ClickHouse e Console ficam escutando no host. Por padrão
# ficam abertos para a rede (0.0.0.0): o Console é a interface web, e o
# ClickHouse permite acesso externo ao banco (Grafana, clientes SQL).
# Use 127.0.0.1 para deixar acessível só localmente (ex.: atrás de um proxy
# reverso ou túnel SSH). Os demais serviços (Kafka, Orchestrator, API do
# inlet) sempre escutam só em 127.0.0.1.
# ATENÇÃO: o Docker ignora o firewalld/UFW para portas publicadas; para
# restringir por IP, veja a seção Firewall do PRODUCTION_CHECKLIST.md.
CLICKHOUSE_BIND=0.0.0.0
CONSOLE_BIND=0.0.0.0

# Portas expostas no host (mude apenas se houver conflito)
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
KAFKA_PORT=9092
# Não mude KAFKA_EXTERNAL_PORT sem ajustar também config/akvorado-inlet.yaml
# e o KAFKA_ADVERTISED_LISTENERS do docker-compose.yml (o inlet conecta em
# 127.0.0.1:9093).
KAFKA_EXTERNAL_PORT=9093
ORCHESTRATOR_HTTP_PORT=8080
ORCHESTRATOR_GRPC_PORT=8081
CONSOLE_HTTP_PORT=8000
